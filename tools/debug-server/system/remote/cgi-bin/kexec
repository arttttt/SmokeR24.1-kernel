#!/system/bin/sh
# Kexec-boot from a boot.img via HTTP POST (like fastboot boot, no flash).
#
# Usage (via httpd):
#   POST /cgi-bin/kexec
#   Request body = raw boot.img contents

BB=/system/remote/busybox
KEXEC=/system/remote/kexec

echo "Content-Type: text/plain"
echo ""

TMP=/dev/kexec_work

cleanup() { cd /; umount $TMP 2>/dev/null; rm -rf $TMP 2>/dev/null; }
trap cleanup EXIT
cleanup
mkdir -p $TMP
mount -t tmpfs tmpfs $TMP -o size=32m

# Save uploaded boot.img
$BB cat > $TMP/boot.img
SIZE=$($BB stat -c%s $TMP/boot.img 2>/dev/null)
[ -z "$SIZE" ] || [ "$SIZE" -lt 1024 ] && { echo "ERROR: invalid boot.img"; exit 1; }

# Parse header
KS=$($BB od -A n -t u4 -j 8 -N 4 $TMP/boot.img | $BB tr -d " ")
RS=$($BB od -A n -t u4 -j 16 -N 4 $TMP/boot.img | $BB tr -d " ")
SS=$($BB od -A n -t u4 -j 24 -N 4 $TMP/boot.img | $BB tr -d " ")
PS=$($BB od -A n -t u4 -j 36 -N 4 $TMP/boot.img | $BB tr -d " ")
DS=$($BB od -A n -t u4 -j 40 -N 4 $TMP/boot.img | $BB tr -d " ")

[ -z "$PS" ] || [ "$PS" -eq 0 ] 2>/dev/null && { echo "ERROR: bad header"; exit 1; }

KP=$(( (KS + PS - 1) / PS * PS ))
RP=$(( (RS + PS - 1) / PS * PS ))
SP=$(( (SS + PS - 1) / PS * PS ))
RO=$(( PS + KP ))
SO=$(( RO + RP ))
DO=$(( SO + SP ))

# Extract components
dd if=$TMP/boot.img bs=$PS skip=1 count=$((KP/PS)) of=$TMP/zImage 2>/dev/null
$BB truncate -s $KS $TMP/zImage
dd if=$TMP/boot.img bs=$PS skip=$((RO/PS)) count=$((RP/PS)) of=$TMP/initrd.img 2>/dev/null
$BB truncate -s $RS $TMP/initrd.img
if [ "$DS" -gt 0 ]; then
    dd if=$TMP/boot.img bs=$PS skip=$((DO/PS)) count=$(((DS+PS-1)/PS)) of=$TMP/dtb.img 2>/dev/null
    $BB truncate -s $DS $TMP/dtb.img
fi

echo "zImage=$KS ramdisk=$RS dtb=$DS"

# Build kexec command
CMDLINE=$(cat /proc/cmdline)
KCMD="$KEXEC --load-hardboot --mem-min=0x85000000 --mem-max=0xd0000000 --boardname=mocha"
KCMD="$KCMD --initrd=$TMP/initrd.img"
[ "$DS" -gt 0 ] && KCMD="$KCMD --dtb=$TMP/dtb.img"
KCMD="$KCMD --append=\"$CMDLINE\""
KCMD="$KCMD $TMP/zImage"

eval $KCMD 2>&1

echo "KEXEC_LOADED"
$KEXEC -e </dev/null >/dev/null 2>&1 &
