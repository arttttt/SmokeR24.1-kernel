#!/system/bin/sh
# Execute a shell command on device via HTTP CGI.
#
# Usage (via httpd):
#   POST /cgi-bin/cmd  — command in request body
#   GET  /cgi-bin/cmd?cmd=<url-encoded-command>
#
# Output: plain text stdout+stderr of the executed command
# Destructive commands (reboot, kexec -e, poweroff) run in background
# so the HTTP response completes before the device goes down.
#
# Requires: busybox (for sed URL decoding)

echo "Content-Type: text/plain"
echo ""
if [ "$REQUEST_METHOD" = "POST" ]; then
    [ -z "$CONTENT_LENGTH" ] && CONTENT_LENGTH=0
    [ "$CONTENT_LENGTH" -gt 0 ] 2>/dev/null && read -n "$CONTENT_LENGTH" CMD
else
    CMD=$(echo "$QUERY_STRING" | /sbin/busybox sed 's/cmd=//;s/+/ /g;s/%20/ /g;s/%2F/\//g;s/%7C/|/g;s/%26/\&/g;s/%3B/;/g;s/%3D/=/g;s/%2D/-/g;s/%22/"/g;s/%27/'"'"'/g;s/%0A/\n/g;s/%3A/:/g;s/%40/@/g;s/%23/#/g;s/%24/$/g;s/%28/(/g;s/%29/)/g;s/%5B/[/g;s/%5D/]/g;s/%7B/{/g;s/%7D/}/g;s/%3C/</g;s/%3E/>/g;s/%60/`/g;s/%7E/~/g')
fi
[ -z "$CMD" ] && { echo "Usage: POST command or GET ?cmd=command"; exit 0; }

# Detect commands that kill the connection (reboot, kexec -e, poweroff)
case "$CMD" in
    *reboot*|*"kexec -e"*|*poweroff*|*halt*)
        echo "OK: executing in background"
        eval "$CMD" </dev/null >/dev/null 2>&1 &
        ;;
    *)
        eval "$CMD" 2>&1
        ;;
esac
