#!/system/bin/sh
# Flash a boot.img to a partition via HTTP POST, with multirom trampoline inject.
#
# Usage (via httpd):
#   POST /cgi-bin/flash?part=LNX
#   Request body = raw boot.img contents
#
# Parameters:
#   part  — partition name (default: LNX). Maps to /dev/block/.../by-name/<part>
#
# Output: "FLASH_OK partition=<part>" on success, "FLASH_FAILED" on error
#   If multirom is installed and part=LNX, also injects trampoline into ramdisk
#   and re-flashes: "INJECT_OK tr_ver=<N>" or "INJECT_FAILED"
#
# Requires: busybox, dd, micropython + rebuild_boot.py (for trampoline inject)

echo "Content-Type: text/plain"
echo ""

BB=/sbin/busybox

# Use tmpfs for cpio work (sdcard fuse doesn't support symlinks)
TMP=/dev/flash_work
cleanup() { cd /; umount $TMP 2>/dev/null; rm -rf $TMP 2>/dev/null; }
trap cleanup EXIT
cleanup
mkdir -p $TMP
mount -t tmpfs tmpfs $TMP -o size=32m
mkdir -p $TMP/rd

MROM=/data/media/0/multirom
PARTNAME=$(echo "$QUERY_STRING" | $BB sed 's/.*part=//;s/&.*//')
[ -z "$PARTNAME" ] && PARTNAME=LNX
PART="/dev/block/platform/sdhci-tegra.3/by-name/$PARTNAME"

# Save uploaded boot.img
$BB cat > $TMP/boot.img
SIZE=$($BB stat -c%s $TMP/boot.img 2>/dev/null)
[ -z "$SIZE" ] || [ "$SIZE" -lt 1024 ] && { echo "ERROR: invalid boot.img ($SIZE bytes)"; exit 1; }
echo "received: $SIZE bytes"

# Flash
if ! dd if=$TMP/boot.img of=$PART bs=4096 2>&1; then
    echo "FLASH_FAILED"
    exit 1
fi
sync
echo "FLASH_OK partition=$PARTNAME"

# Inject multirom trampoline (only for LNX, only if multirom installed)
if [ "$PARTNAME" = "LNX" ] && [ -f "$MROM/trampoline" ]; then
    echo "injecting trampoline..."

    # Parse boot.img header
    PS=$($BB od -A n -t u4 -j 36 -N 4 $TMP/boot.img | $BB tr -d " ")
    KS=$($BB od -A n -t u4 -j 8 -N 4 $TMP/boot.img | $BB tr -d " ")
    RS=$($BB od -A n -t u4 -j 16 -N 4 $TMP/boot.img | $BB tr -d " ")

    if [ -z "$PS" ] || [ "$PS" -eq 0 ] 2>/dev/null; then
        echo "INJECT_FAILED: bad header"
        exit 1
    fi

    KP=$(( (KS + PS - 1) / PS * PS ))
    RO=$(( PS + KP ))

    # Extract ramdisk
    dd if=$TMP/boot.img bs=$PS skip=$((RO/PS)) count=$(((RS+PS-1)/PS)) 2>/dev/null | $BB head -c $RS > $TMP/ramdisk.gz

    # Unpack
    cd $TMP/rd
    $BB gzip -d -c $TMP/ramdisk.gz | $BB cpio -i 2>/dev/null

    # Inject trampoline
    [ ! -f main_init ] && mv init main_init
    cp $MROM/trampoline init
    chmod 750 init
    rm -f sbin/ueventd sbin/watchdogd
    $BB ln -s ../main_init sbin/ueventd
    $BB ln -s ../main_init sbin/watchdogd
    [ -f $MROM/mrom.fstab ] && cp $MROM/mrom.fstab .

    # Repack ramdisk (find * to avoid . entry with drwx------ permissions)
    $BB find * | $BB cpio -o -H newc 2>/dev/null | $BB gzip > $TMP/ramdisk_new.gz

    # Find micropython (prefer system paths — tmpfs may be noexec)
    MPY=/sbin/micropython
    [ ! -x $MPY ] && MPY=/system/bin/micropython
    [ ! -x $MPY ] && MPY=$TMP/rd/sbin/micropython
    RBP=/sbin/rebuild_boot.py
    [ ! -f $RBP ] && RBP=/system/bin/rebuild_boot.py
    [ ! -f $RBP ] && RBP=$TMP/rd/sbin/rebuild_boot.py

    TR_VER=$($MROM/trampoline -v 2>/dev/null || echo 27)
    cd $TMP
    chmod 755 $MPY 2>/dev/null
    $MPY $RBP $TMP/boot.img $TMP/ramdisk_new.gz $TR_VER $TMP/boot_injected.img 2>&1

    if [ -f $TMP/boot_injected.img ]; then
        dd if=$TMP/boot_injected.img of=$PART bs=4096 2>&1
        sync
        echo "INJECT_OK tr_ver=$TR_VER"
    else
        echo "INJECT_FAILED"
    fi
fi

echo "DONE"
