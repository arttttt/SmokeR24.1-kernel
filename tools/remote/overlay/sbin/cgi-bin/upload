#!/system/bin/sh
# Upload a file to the device via HTTP POST.
#
# Usage (via httpd):
#   POST /cgi-bin/upload?path=/sdcard/tmp/boot.img
#   Request body = raw file contents
#
# Parameters:
#   path  — destination path on device (URL-encoded query param)
#
# Output: "OK: <path> (<size> bytes)" on success, "ERROR: ..." on failure
#
# Requires: busybox (for sed, cat, ls, awk)

echo "Content-Type: text/plain"
echo ""
DEST=$(echo "$QUERY_STRING" | /sbin/busybox sed 's/path=//;s/%2F/\//g;s/%20/ /g')
[ -z "$DEST" ] && { echo "ERROR: specify ?path=/tmp/boot.img"; exit 1; }
/sbin/busybox cat > "$DEST"
SIZE=$(/sbin/busybox ls -l "$DEST" | /sbin/busybox awk '{print $5}')
echo "OK: $DEST ($SIZE bytes)"
