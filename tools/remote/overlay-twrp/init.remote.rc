# TWRP recovery service definitions for WiFi remote debug.
# Imported by init.rc (added by patch_ramdisk.sh --twrp).
#
# All services start on boot independently:
#   - wificonnect: best-effort WiFi setup (never crashes recovery)
#   - telnetd on port 2323
#   - remotehttpd on port 8080

# The watchdog is not a remote-debug concern -- a recovery resets itself with
# or without this overlay -- so feeding it lives in init.recovery.tn8.rc, which
# init.rc imports on its own. Defining it here as well would be a duplicate
# service, and init keeps the first and warns about the second.
service wificonnect /sbin/wifi-connect.sh
    class default
    oneshot
    seclabel u:r:recovery:s0

service telnetd /sbin/busybox telnetd -l /sbin/sh -b 0.0.0.0 -p 2323 -F
    class default
    oneshot
    seclabel u:r:recovery:s0

service remotehttpd /sbin/remote-server.sh
    class default
    oneshot
    seclabel u:r:recovery:s0

on boot
    start wificonnect
    start telnetd
    start remotehttpd
