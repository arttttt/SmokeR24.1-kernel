# The gadget this recovery composes into.
#
# What this replaces wrote the whole thing to /sys/class/android_usb/android0,
# because the kernel TWRP was built against still had android.c. The kernel
# underneath it now is the LineageOS one, which has only configfs, so every one
# of those writes landed nowhere at all: no gadget, no adb, and a device that
# charges and is otherwise invisible to the host.
#
# There is no gadget HAL in recovery, so this file does the whole job -- the
# gadget, its strings, the adb function, and finally the controller. The order
# matters twice over. The function instance has to exist before init.rc mounts
# functionfs onto it, which it does in "on fs"; and the controller must not be
# written until the daemon has put its descriptors into that instance, or the
# host enumerates a configuration that cannot answer.

on init
    mkdir /config
    mount configfs none /config

    mkdir /config/usb_gadget/g1 0770 shell shell
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell

    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0xd001
    write /config/usb_gadget/g1/bcdDevice 0x0223
    write /config/usb_gadget/g1/bDeviceClass 0
    write /config/usb_gadget/g1/bDeviceSubClass 0
    write /config/usb_gadget/g1/bDeviceProtocol 0
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration adb
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500

    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1

# adbd is declared "disabled" in init.rc and was started by the sys.usb.config
# trigger that used to live here. Nothing sets that property any more, so it is
# started outright, once functionfs is mounted.
on fs
    start adbd

# Only now is there a configuration worth enumerating. The controller is
# tegra-udc.0: udc-core names the entry in /sys/class/udc after the parent
# device, and board-ardbeg.c gives the one probed from udc@7d000000 that legacy
# name through OF_DEV_AUXDATA -- 7d000000.udc, which the tree alone would
# imply, matches nothing and fails with ENODEV.
on property:sys.usb.ffs.ready=1
    write /config/usb_gadget/g1/UDC tegra-udc.0
