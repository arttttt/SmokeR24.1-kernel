#!/system/bin/sh
echo "Content-Type: text/plain"
echo ""

# Extract filename from query string: /cgi-bin/upload?path=/tmp/boot.img
DEST=$(echo "$QUERY_STRING" | busybox sed 's/path=//;s/%2F/\//g;s/%20/ /g')

if [ -z "$DEST" ]; then
    echo "ERROR: specify ?path=/tmp/boot.img"
    exit 1
fi

# Read binary POST body and write to destination
busybox cat > "$DEST"
SIZE=$(busybox ls -l "$DEST" | busybox awk '{print $5}')
echo "OK: $DEST ($SIZE bytes)"
